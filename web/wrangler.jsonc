{
  // ルート設定。ビルド時に @astrojs/cloudflare がこれを取り込んで
  // dist/server/wrangler.json を生成するため、デプロイは生成物を指定する:
  //   bun run build && bunx wrangler deploy -c dist/server/wrangler.json
  // ここに main を書くとビルド前に dist/_worker.js を解決しようとして失敗する。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webscreen-beta",
  // 同梱 wrangler の workerd がサポートする上限日。上げる時は wrangler も同時に上げる
  // （未来日にすると prerender 時の miniflare 起動が失敗する）。
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "R2_ACCOUNT_ID": "65850b2bd0055921bdcfbe42383c794a",
    "R2_BUCKET_NAME": "webscreen-beta",
    // 動画の配信元。r2.dev は Cloudflare が「rate-limited / non-production traffic」と
    // 明記する開発専用エンドポイントで、VRChat のワールド内で複数人が同時に取得する
    // 本番用途には耐えない。Custom Domain 経由にするとキャッシュが効き、WAF も使える。
    // 既存の r2.dev URL は共有済みリンクを壊さないため公開したまま並走させている。
    //
    // 注意: mp4 は Cloudflare の既定キャッシュ対象で、200/206 の Edge TTL は 120 分。
    // R2 から削除してもキャッシュ済みのオブジェクトはその間配信され続ける（削除時の
    // purge は未実装。詳細と対処は docs/r2-delivery.md）。
    "R2_PUBLIC_BASE_URL": "https://cdn.web-screen.net",
    "WEBCAPTURE_URL": "https://web-capture-345811595113.asia-northeast1.run.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webscreen-beta-db",
      "database_id": "8e95e386-039b-4589-a442-8cc7ca7e6996"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webscreen-beta"
    }
  ],
  // Astro のセッション機能が既定で要求する KV。初回 deploy で wrangler が
  // 自動プロビジョニングしたものを、再デプロイ時の取り違えを防ぐため明示している。
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8318e211fb8c4caebb81bc04745b438b"
    }
  ]
}
