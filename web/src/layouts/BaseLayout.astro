---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { alternateLocale, switchLocalePath, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /**
   * アクセス解析を読み込むか。
   *
   * 既定は true。プレビューページだけ false にしている: GA4 は page_title / page_location を
   * 既定で送るため、タイトルに入るアップロード済みファイル名と、共有 URL そのものである
   * shortId が Google へ渡ってしまう。
   */
  analytics?: boolean;
}

const { lang, title, description, analytics = true } = Astro.props;
const t = useTranslations(lang);
const other = alternateLocale(lang);

// SRI 付きで固定バージョンを読む（CDN 側の差し替えをブラウザが検出できるようにする）。
const FONT_AWESOME_URL = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.1.0/css/all.min.css';
const FONT_AWESOME_SRI = 'sha384-YgSbYtJcfPnMV/aJ0UdQk84ctht/ckX0MrfQwxOhw43RMBw2WSaDSMVh4gQwLdE4';

// 旧 FastAPI 版と同じ測定 ID。ドメイン切替の前後でレポートを分断させないため引き継ぐ。
// HTML に出力される公開値なので環境変数に隠さない（隠しても意味がなく、参照が増えるだけ）。
const GA_MEASUREMENT_ID = 'G-W7D0GRPM2Y';

// 計測するホスト。β Worker（*.workers.dev）・localhost・E2E のトラフィックを
// 本番レポートへ混ぜないため、ここに一致した時だけタグを読み込む。
const GA_TRACKED_HOST = 'web-screen.net';
---

<!doctype html>
<html lang={lang} data-auth-state="guest">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <link rel="alternate" hreflang={other} href={switchLocalePath(Astro.url.pathname, other)} />
    <link
      rel="stylesheet"
      href={FONT_AWESOME_URL}
      integrity={FONT_AWESOME_SRI}
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    {
      analytics && (
        <script
          is:inline
          define:vars={{ gaMeasurementId: GA_MEASUREMENT_ID, gaTrackedHost: GA_TRACKED_HOST }}
        >
          // 静的ページはビルド時に生成されるためサーバー側でホストを判定できない。描画時に見る。
          if (location.hostname === gaTrackedHost) {
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaMeasurementId);

            // COEP: credentialless 下でも no-cors のサブリソースは読めるため crossorigin を
            // 付けない（付けると CORS モードになり、gtag.js 側が ACAO を返さず逆に落ちる）。
            const tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaMeasurementId;
            document.head.appendChild(tag);
          }
        </script>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900 antialiased">
    <SiteHeader lang={lang} />

    <main class="flex-1">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script>
      // ログイン状態は静的 HTML に埋め込めないので、描画後に /api/me/ で解決する。
      import { resolveAuthState } from '../lib/ui/session-view';

      void resolveAuthState(document.documentElement);
    </script>
  </body>
</html>
