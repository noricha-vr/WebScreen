---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const REPOSITORY_URL = 'https://github.com/noricha-vr/WebScreen';
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-base text-slate-600"
  >
    <p>{t.footer.note}</p>

    <nav class="flex items-center gap-4">
      <a
        href={REPOSITORY_URL}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-slate-700 underline hover:text-brand-700"
      >
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        <span>{t.footer.github}</span>
      </a>
      <a
        href={`/${lang}/privacy/`}
        class="inline-flex items-center gap-2 text-slate-700 underline hover:text-brand-700"
      >
        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        <span>{t.footer.privacy}</span>
      </a>
    </nav>
  </div>
</footer>
