---
import { useTranslations, type Locale } from '../i18n';
import { USE_CASE_SLUGS, useCasePath, type UseCasePage } from '../lib/use-cases';

/**
 * 用途別ページ（Web / 画面共有 / 画像 / PDF）の本文。
 *
 * 検索から入ってきた人に「その用途で何ができるか」を説明し、トップの変換パネルへ送るのが役割。
 * 変換機能そのものはトップに置いたままにする（入口を分散させると、どこで変換するのか分からなくなる）。
 * 文言は i18n の useCases 配下が正本で、ここには構造だけを持たせる。
 */

interface Props {
  lang: Locale;
  page: UseCasePage;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);
const content = t.useCases[page];

/** 関連ページは自分以外の 3 つ。USE_CASE_SLUGS の宣言順に出す。 */
const related = (Object.keys(USE_CASE_SLUGS) as UseCasePage[]).filter((key) => key !== page);
---

<article class="mx-auto max-w-3xl px-4 py-12">
  <h1 class="text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl">
    {content.heading}
  </h1>
  <p class="mt-4 text-lg leading-relaxed text-slate-700">{content.lead}</p>

  <div class="mt-10 grid gap-10">
    {
      content.sections.map((section) => (
        <section>
          <h2 class="text-2xl font-bold leading-snug tracking-tight text-slate-900">
            {section.heading}
          </h2>
          <p class="mt-3 text-base leading-relaxed text-slate-700">{section.body}</p>
        </section>
      ))
    }
  </div>

  <section class="mt-12 rounded-xl border border-slate-200 bg-slate-50 p-6">
    <h2 class="text-xl font-bold tracking-tight text-slate-900">{t.useCases.stepsHeading}</h2>
    <ol class="mt-4 grid list-decimal gap-3 pl-5 text-base leading-relaxed text-slate-700">
      {content.steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <p class="mt-10">
    <a
      href={`/${lang}/`}
      class="inline-flex items-center gap-3 rounded-md bg-brand-500 px-6 py-4 text-lg font-semibold text-white hover:bg-brand-700"
    >
      <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
      <span>{content.cta}</span>
    </a>
  </p>

  <nav class="mt-14 border-t border-slate-200 pt-8">
    <h2 class="text-lg font-semibold text-slate-900">{t.useCases.relatedHeading}</h2>
    <ul class="mt-3 grid gap-2 text-base">
      {
        related.map((key) => (
          <li>
            <a
              href={useCasePath(lang, key)}
              class="inline-flex items-center gap-2 text-slate-700 underline hover:text-brand-700"
            >
              <i class="fa-solid fa-arrow-right text-brand-500" aria-hidden="true" />
              <span>{t.useCases[key].navLabel}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</article>
