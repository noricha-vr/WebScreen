---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="mx-auto max-w-3xl px-4 py-12">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">{t.privacy.heading}</h1>
  <p class="mt-3 text-lg text-slate-700">{t.privacy.lead}</p>

  <div class="mt-8 overflow-x-auto">
    <table class="min-w-[34rem] border-collapse text-left text-base">
      <caption class="pb-2 text-left text-base text-slate-600">{t.privacy.tableCaption}</caption>
      <thead>
        <tr class="border-b border-slate-300 text-slate-900">
          <th scope="col" class="whitespace-nowrap py-2 pr-4 font-semibold">{t.privacy.columnName}</th>
          <th scope="col" class="whitespace-nowrap py-2 pr-4 font-semibold">{t.privacy.columnPurpose}</th>
          <th scope="col" class="whitespace-nowrap py-2 pr-4 font-semibold">{t.privacy.columnExpiry}</th>
          <th scope="col" class="whitespace-nowrap py-2 font-semibold">{t.privacy.columnShared}</th>
        </tr>
      </thead>
      <tbody>
        {
          t.privacy.cookies.map((cookie) => (
            <tr class="border-b border-slate-200 text-slate-700">
              <td class="py-2 pr-4 font-mono">{cookie.name}</td>
              <td class="py-2 pr-4">{cookie.purpose}</td>
              <td class="py-2 pr-4">{cookie.expiry}</td>
              <td class="py-2">{t.privacy.notShared}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-8 grid gap-4 text-base leading-relaxed text-slate-700">
    {t.privacy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</article>
