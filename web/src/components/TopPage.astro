---
import ConvertPanel from './ConvertPanel.astro';
import CrossOriginIsolationStatus from './CrossOriginIsolationStatus.astro';
import GuestHero from './GuestHero.astro';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<div class="mx-auto max-w-5xl px-4 py-12">
  <!-- 未ログイン / ログイン済みの両方を出しておき、data-auth-state で切り替える -->
  <div data-auth-only="guest">
    <GuestHero lang={lang} />
  </div>

  <div data-auth-only="member">
    <ConvertPanel lang={lang} />
  </div>

  <!-- FFmpeg.wasm の前提（SharedArrayBuffer）が満たされているかの実機表示 -->
  <div class="mt-12 rounded-lg bg-slate-900 px-4 py-2">
    <CrossOriginIsolationStatus label="crossOriginIsolated:" />
  </div>
</div>
