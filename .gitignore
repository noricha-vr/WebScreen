.env
*.png
*.mp4
credentials.json
/drivers/
/project/
/html/
/test/project/
/test/html/
/image/
.DS_Store
.idea
__pycache__
# テスト用フィクスチャの生成物（generate_slides.py で再生成可能）
test_slides/*.pdf

# Cloudflare β 版（web/）の生成物。bun.lock はサプライチェーン対策で追跡する
web/node_modules/
web/dist/
web/.astro/

# OG 画像は配信物なので、先頭の *.png 除外から戻す
!web/public/og.png
web/.dev.vars

# wrangler のローカルキャッシュ（Cloudflare アカウント情報を含む）
.wrangler/

# Playwright の実行成果物（trace / レポート HTML）
web/test-results/
web/playwright-report/

# テスト用 fixture は追跡する（*.mp4 除外の例外）
!web/e2e/fixtures/
!web/e2e/fixtures/**
